{
  "type": "minecraft:sequence",
  "sequence": [
    {
      "type": "minecraft:condition",
      "if_true": "minecraft:on_floor",
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": "minecraft:not_underwater",
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:noise_threshold",
                    "max_threshold": 0.06,
                    "min_threshold": -0.06,
                    "noise": "minecraft:gravel"
                  },
                  "then_run": {
                    "type": "minecraft:sequence",
                    "sequence": [
                      {
                        "type": "minecraft:condition",
                        "if_true": "minecraft:on_ceiling",
                        "then_run": {
                          "type": "minecraft:block",
                          "result_state": "kingdomsatwar:stormstone"
                        }
                      },
                      {
                        "type": "minecraft:block",
                        "result_state": "minecraft:gravel"
                      }
                    ]
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:steep"
                  },
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "kingdomsatwar:stormstone"
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:y_above",
                    "add_stone_depth": true,
                    "anchor": {
                      "absolute": 70
                    },
                    "surface_depth_multiplier": 0
                  },
                  "then_run": {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:noise_threshold",
                      "max_threshold": 1.7976931348623157E308,
                      "min_threshold": 0.12,
                      "noise": "minecraft:surface"
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": "minecraft:grass_block"
                    }
                  }
                },
                {
                  "type": "minecraft:block",
                  "result_state": "kingdomsatwar:stormstone"
                }
              ]
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:noise_threshold",
              "max_threshold": 0.06,
              "min_threshold": -0.06,
              "noise": "minecraft:gravel"
            },
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": "minecraft:on_ceiling",
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "kingdomsatwar:stormstone"
                  }
                },
                {
                  "type": "minecraft:block",
                  "result_state": "minecraft:gravel"
                }
              ]
            }
          },
          {
            "type": "minecraft:block",
            "result_state": "kingdomsatwar:stormstone"
          }
        ]
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": "minecraft:not_under_deep_water",
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": "minecraft:under_floor",
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:steep"
                  },
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "kingdomsatwar:stormstone"
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:y_above",
                    "add_stone_depth": true,
                    "anchor": {
                      "absolute": 70
                    },
                    "surface_depth_multiplier": 0
                  },
                  "then_run": {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:noise_threshold",
                      "max_threshold": 1.7976931348623157E308,
                      "min_threshold": 0.12,
                      "noise": "minecraft:surface"
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": "minecraft:dirt"
                    }
                  }
                },
                {
                  "type": "minecraft:block",
                  "result_state": "kingdomsatwar:stormstone"
                }
              ]
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": "minecraft:very_deep_under_floor",
            "then_run": {
              "type": "minecraft:block",
              "result_state": "kingdomsatwar:stormstone"
            }
          }
        ]
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": "minecraft:under_floor",
      "then_run": {
        "type": "minecraft:block",
        "result_state": "kingdomsatwar:stormstone"
      }
    }
  ]
}